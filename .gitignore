# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
build/
dist/

# Environment / secrets — never commit these
.env
.env.local
.env*.local

# Logs & OS noise
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Vercel
.vercel

# --- Capacitor ---
# The native PROJECTS (android/ and ios/) ARE committed — Codemagic builds from them.
# Only their generated build output and copied web assets are ignored.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/src/main/assets/public/
android/app/release/
ios/App/Pods/
ios/App/build/
ios/App/App/public/
ios/DerivedData/
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
